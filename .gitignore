### Flutter ###
# Built application files
*.apk
*.aab
*.exe
*.ipa
*.app

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# The .vscode/ directory contains emulator-specific logic which is not
# necessary for the application.
.vscode/

